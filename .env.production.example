# Required runtime mode.
NODE_ENV=production

# Docker image to run. Pin this to the versioned tag for production upgrades.
FORENOTES_IMAGE=ngynduc/forenotes:latest

# Application bind and published host port.
APP_HOST=0.0.0.0
APP_PORT=3000
FORENOTES_HOST_PORT=3000

# PostgreSQL container settings. Keep these aligned with DATABASE_URL.
POSTGRES_USER=forenotes
POSTGRES_PASSWORD=change_me_to_a_long_random_database_password
POSTGRES_DB=forenotes
DATABASE_URL=postgres://forenotes:change_me_to_a_long_random_database_password@postgres:5432/forenotes

# First-admin bootstrap. This is used only when no admin exists.
FORENOTES_BOOTSTRAP_ADMIN_USERNAME=admin
FORENOTES_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
FORENOTES_BOOTSTRAP_ADMIN_DISPLAY_NAME=Forenotes Admin
FORENOTES_BOOTSTRAP_ADMIN_PASSWORD=change_me_to_a_long_random_temporary_password
FORENOTES_BOOTSTRAP_ADMIN_TEMPORARY=true

# Required for encrypting stored per-user LLM API keys. Use 32+ random characters.
FORENOTES_LLM_SECRET_KEY=change_me_to_at_least_32_random_characters

# Set to true when serving through HTTPS. Use false only for local HTTP testing.
SECURE_SESSION_COOKIES=true

# Optional report LLM service endpoint. Leave empty to disable service-backed report generation.
# Example: LITELLM_SERVICE_URL=http://llm-service.example.internal:8001
LITELLM_SERVICE_URL=

# Optional environment-level LLM defaults. Users can also configure LLM settings in the app.
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
LLM_API_ENDPOINT=
LLM_SYSTEM_PROMPT=
LLM_CUSTOM_HEADERS_JSON={}
